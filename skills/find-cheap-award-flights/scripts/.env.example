# Seats.aero Pro API key — powers the cached "SkyView" mode. NOT an airline password.
# Get it from seats.aero -> Settings -> API (format: pro_xxxxxxxxxxxxx).
SEATS_AERO_API_KEY=

# Path to a Chrome user-data-dir already logged into your airline accounts.
# Recommended: copy your real profile so automation never touches your daily browser, e.g.
#   mkdir -p ~/.award-travel && cp -R "$HOME/Library/Application Support/Google/Chrome/Default" ~/.award-travel/chrome-profile
# then set:
AWARD_CHROME_PROFILE=

# Optional — enables the Groq LLM extraction fallback when a scraper's selectors break.
# Get a free key at console.groq.com. Leave unset to disable the fallback entirely.
# GROQ_API_KEY=
